# Database
DATABASE_URL=postgresql://seo:seo@localhost:5432/seo_agency

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key!!

# Auth (dev mode uses simple session; set for production)
AUTH_SECRET=dev-auth-secret-change-in-production

# Anthropic Claude
ANTHROPIC_API_KEY=

# Image generation (fal.ai Flux)
FAL_KEY=

# Object storage (S3 / R2) — leave empty to use local uploads/
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Meta (Facebook / Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/oauth/meta/callback

# WordPress — per-client credentials stored in ChannelConnection

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/oauth/tiktok/callback

# YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/youtube/callback

# Creatomate (short-form video)
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# Notifications
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=alerts@agency.local

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
